# Скопируйте в .env и подставьте свои значения. Файл .env не коммитится.

# PostgreSQL
# Для npm run dev (без Docker): хост localhost
DATABASE_URL=postgresql://materiamedica:YOUR_PASSWORD@localhost:5432/materiamedica
# Для docker-compose.dev: задаётся POSTGRES_PASSWORD; приложение в контейнере получит URL с хостом db автоматически.
# Если пароль содержит @ : / $ % и т.п., укажите полный URL с закодированным паролем:
# DATABASE_URL_DOCKER=postgresql://materiamedica:encoded_password@db:5432/materiamedica
POSTGRES_PASSWORD=your_postgres_password

# Node.js
SESSION_SECRET=your_session_secret_min_32_chars

# Redis (WebSocket pub/sub and recent messages cache). Without REDIS_URL real-time updates do not work.
# Local: REDIS_URL=redis://localhost:6379
# docker-compose.prod sets redis://redis:6379 by default; override here if needed.
# REDIS_URL=redis://redis:6379

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@hovial.com
# Задержка push (мс): если за это время пришло «прочитано», push не отправляется
# PUSH_DELAY_MS=5000

# LiveKit (голосовые конференции). Self-hosted SFU.
# LIVEKIT_URL — публичный WSS-адрес сигналинга (через nginx /livekit).
#   dev: ws://localhost:7880 ; prod: wss://hovial.com/livekit
# LIVEKIT_API_HOST — HTTP-адрес Server API для сверки комнат (RoomService).
#   В Docker: http://livekit:7880 ; локально: http://localhost:7880
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET — пара ключей; та же пара передаётся
#   контейнеру livekit через LIVEKIT_KEYS. Секрет минимум 32 символа.
#   В dev используется пара devkey: secret (см. livekit/livekit.dev.yaml).
#   api_key в livekit/livekit.yaml (секция webhook) должен совпадать с LIVEKIT_API_KEY.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_HOST=http://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# ВАЖНО: на проде открыть на firewall порты 7882/udp, 7881/tcp, 5349/tcp.

# Yandex Cloud S3
YC_BUCKET=your_bucket
YC_REGION=ru-central1
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=

# Robokassa
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# Для docker-compose.dev: COOKIE_SECURE=false задаётся в compose. Для прода — .env.prod с COOKIE_SECURE=true
# APP_URL=https://hovial.com
